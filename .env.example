# From the Auth tab of your LinkedIn app
LI_CLIENT_ID=
LI_CLIENT_SECRET=

# Where tokens, expiry dates and the request counter live (created with 0600 files)
LI_STATE_DIR=state
LI_DAILY_CAP=90
# First Monday to backfill weekly rows from
LI_SINCE=2026-01-05

# csv (default) or sheets
OUTPUT=csv
CSV_DIR=data
POSTS_FILE=posts.csv

# Only for OUTPUT=sheets: share the sheet with the service account email
SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
